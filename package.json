{
  "name": "consent-ahead",
  "version": "1.1.0",
  "private": true,
  "description": "Personal Data Firewall, a privacy-first Chrome extension",
  "scripts": {
    "dev:extension": "pnpm -F extension dev",
    "build:extension": "pnpm -F extension build",
    "build:api": "pnpm -F api build",
    "build:all": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "legal:md": "pnpm -F extension legal:md",
    "deploy:aws": "node infra/deploy.mjs",
    "destroy:aws": "node infra/deploy.mjs --destroy"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
